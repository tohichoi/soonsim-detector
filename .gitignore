# Python Virtual Environments & Cache
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Sensitive Configurations & Secrets (Keep config.example.toml tracked)
config/config.toml
config/config.local.toml
*.env
*.env.*

# Media, Recordings & Snapshots
records/
debug_output/
*.mp4
*.avi
*.mkv
*.jpg
*.jpeg
*.png

# Promotional media assets (tracked despite the global media ignore above)
!docs/assets/
!docs/assets/**

# Raw pipeline output (soonsim_YYYYMMDD_HHMMSS.mp4) — never commit these.
# The pipeline writes MPEG-4 Part 2, which browsers cannot play, and the
# portfolio build copies docs/assets/ verbatim regardless of gitignore.
# Re-encode to H.264 first; see detection_01_on_pad.mp4 for the expected form.
docs/assets/soonsim_*.mp4

# Model Weights (Downloaded on demand)
*.pt
*.onnx
models/*.pt
models/*.onnx

# OS & IDE Files
.DS_Store
.idea/
.vscode/
*.swp
